# Development only. Runtime cryptographic keys are generated into a persistent volume.
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://api:3001
COOKIE_SECURE=false
DATABASE_URL=postgresql://nexacred:nexacred@postgres:5432/nexacred?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=
PII_ENCRYPTION_KEY=
PII_HMAC_SECRET=
MOCK_WEBHOOK_SECRET=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=nexacred
MINIO_SECRET_KEY=local-development-storage
MINIO_BUCKET=imports
MINIO_USE_SSL=false
STORAGE_RETENTION_DAYS=7
IMPORT_BATCH_SIZE=1000
IMPORT_UPDATE_POLICY=replace
XLSB_MAX_UNCOMPRESSED_BYTES=8589934592
MOCK_FAILURE_RATE=0
CONTACT_FREQUENCY_HOURS=24
CORS_ORIGINS=http://localhost:3000
SEED_DEMO=true
DEV_ADMIN_EMAIL=admin@nexacred.local
DEV_ADMIN_PASSWORD=DevOnly-ChangeMe123!
CHATWOOT_ENABLED=false
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
LOG_LEVEL=info
WHATSAPP_LAB_ENABLED=false
WHATSAPP_LAB_URL=http://whatsapp-lab:3010
# Até 5 números brasileiros de teste, em E.164, separados por vírgula.
WHATSAPP_TEST_NUMBERS=
WHATSAPP_DATA_DIR=/data
