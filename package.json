{
  "name": "nexacred",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @nexacred/api --filter @nexacred/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @nexacred/database generate",
    "db:migrate": "pnpm --filter @nexacred/database migrate",
    "db:seed": "pnpm --filter @nexacred/database seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "@playwright/test": "^1.55.0"
  }
}
